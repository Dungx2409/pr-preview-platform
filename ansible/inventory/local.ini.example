# Example inventory for local VirtualBox VM
# Copy this file to ansible/inventory/local.ini and update values as needed.

[k3s_server]
devops-server ansible_host=192.168.56.10

[k3s:children]
k3s_server

[all:vars]
ansible_user=vboxuser
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/id_ed25519
